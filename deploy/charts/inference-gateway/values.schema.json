{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "inference-gateway values",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["ollama", "vllm"] }
      }
    },
    "admission": {
      "type": "object",
      "properties": {
        "maxMessages": { "type": "integer", "minimum": 1 },
        "maxPromptChars": { "type": "integer", "minimum": 1 },
        "maxRequestBodyBytes": { "type": "integer", "minimum": 1 },
        "maxCompletionTokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
